{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unseenkey",
  "version": "0.1.3",
  "identifier": "dev.unseenkey.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unseenkey",
        "label": "main",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5N0Y1MjFENkI1Rjg3RjcKUldUM2gxOXJIVkovNlE1RGx4SFU2MHBkaExQRmVOUHJLbDN2bXVnaFk5a1VmRjltMGRtN0NDVWgK",
      "endpoints": [
        "https://github.com/Bhagyesh97/unseenkey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
